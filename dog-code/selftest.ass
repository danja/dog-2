; DOG-2 SELFTEST (simple loop)
; Verifies memory roundtrip, simple add, stack push/pop, then beeps twice and loops.
; On failure shows ERR and halts.

START 0000

; Tempo
TEMPO 64          ; ~100 bpm

; Memory roundtrip: A -> [0100] -> B -> compare
LDAi AA
STAa 0100
LDBa 0100
CMPAi AA
BZS 02            ; if equal, skip error BRA
BRA 29            ; -> ERR

; Arithmetic: 3 + 5 = 8
LDAi 03
LDBi 05
ABA
CMPAi 08
BZS 02            ; if equal, skip error BRA
BRA 1E            ; -> ERR

; Stack push/pop preserves A
PUSHXA
LDAi 00
POPXA
CMPAi 08
BZS 02            ; if equal, skip error BRA
BRA 14            ; -> ERR

; Audio: two tones
LDAi 08
LDBi 10
TONEAB
REST 08
LDAi 0C
LDBi 10
TONEAB
REST 08

; Restart the system so self-test repeats
RESET

; Padding (unused)
NOP
NOP
NOP
NOP

; Error handler
ERR
REST 10
HALT
